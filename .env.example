# PostgreSQL (Neon) — connection string for the admin backend.
# Never commit real credentials; use a secrets manager in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Bootstrap administrative account, created on first run when both are set.
# The password is stored as a bcrypt hash; never commit real credentials.
ADMIN_EMAIL="admin@example.test"
ADMIN_PASSWORD="change-me"

# Cloudflare R2 (object storage de imagens). Optional: when all five are set,
# image uploads go to R2; missing configuration fails closed outside local
# development/test (including Vercel). Never commit real credentials.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL for uploaded objects (custom domain or r2.dev domain).
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# Existing production admin opt-in; keep disabled by default. This does not
# unlock a Vercel Preview without the restricted branch gate below. The new
# Preview gate does not unlock customer authentication in production.
ADMIN_ENABLED="0"

# Server-only opt-in, scoped to Vercel Preview + homologacao/funcional-e2e.
# Set only for that branch; never prefix with NEXT_PUBLIC_. Requires Vercel
# system variables VERCEL=1, VERCEL_ENV=preview, VERCEL_GIT_COMMIT_REF.
PREVIEW_BACKEND_ENABLED="0"
# Exact HTTPS origin of the protected Preview; no trailing slash or path.
APP_ORIGIN=""
# Local capture ONLY. Do not configure a public endpoint. A remote Vercel
# function cannot reach a developer's loopback: recovery remains unavailable
# until a separately authorized private sandbox delivery adapter is supplied.
MAILPIT_URL="http://127.0.0.1:18025"
